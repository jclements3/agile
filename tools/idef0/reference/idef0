# --------------------------------------------------------------- svg
CW, CH, PAD = 9, 18, 20


def _elbow(sx, sy, midx, dyy, dxx, r=7):
    """Orthogonal H-V-H route with rounded (filleted) corners, as on
    traditional IDEF0 plates. Falls back to sharp segments when a leg
    is too short to fillet."""
    if sy == dyy:
        return f"M{sx},{sy} H{dxx}"
    vy = 1 if dyy > sy else -1
    hx2 = 1 if dxx >= midx else -1
    rr = min(r, abs(midx - sx) / 2, abs(dyy - sy) / 2,
             abs(dxx - midx) / 2 if dxx != midx else r)
    if rr < 1:
        return f"M{sx},{sy} H{midx} V{dyy} H{dxx}"
    return (f"M{sx},{sy} H{midx - rr:g} "
            f"Q{midx},{sy} {midx},{sy + vy * rr:g} "
            f"V{dyy - vy * rr:g} "
            f"Q{midx},{dyy} {midx + hx2 * rr:g},{dyy} "
            f"H{dxx}")


def svg_plate(t, node, boxes, pageno, rich=False):
    pos, bw, left, top, W, H, ext_controls = layout_plate(t, node, boxes)

    def _dattr(el):
        if el is None or not el.doc or not rich:
            return ""
        return f' class="hasdoc" data-doc="{_dkey(t, el)}"'

    def _dtitle(el):
        if el is None or not el.doc or rich:
            return ""
        return "<title>" + _h.escape(_doc_plain(el)) + "</title>"

    def X(c):
        return c * CW + PAD

    def Y(r):
        return r * CH + PAD

    box_ids = {id(b) for b in boxes}
    width = X(max(W, 64)) + PAD
    height = Y(H + 4) + PAD
    o = []
    o.append(f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" '
             f'height="{height}" viewBox="0 0 {width} {height}" '
             f'font-family="IBM Plex Mono,monospace">')
    o.append(f'<rect width="{width}" height="{height}" fill="#fdfcf8"/>')
    o.append('<defs><marker id="arr" markerWidth="8" markerHeight="8" '
             'refX="7" refY="3" orient="auto"><path d="M0,0 L7,3 L0,6 z" '
             'fill="#222"/></marker></defs>')
    for ci, cname in enumerate(ext_controls):
        row = 2 * ci
        cons = [b for b in boxes
                if any(p.tag == "c" and p.name == cname for p in b.ports)]
        if not cons:
            continue
        x0, _ = pos[id(cons[0])]
        dp = next((p for b2 in cons for p in b2.ports
                   if p.tag == "c" and p.name == cname and p.doc), None)
        o.append(f'<text x="{X(x0 + 2)}" y="{Y(row) + 12}" font-size="11"'
                 f'{_dattr(dp)}>{_h.escape(cname)}{_dtitle(dp)}</text>')
        for b in cons:
            x, y = pos[id(b)]
            cx = X(x + bw // 2)
            o.append(f'<path d="M{cx},{Y(row) + 16} V{Y(y)}" fill="none" '
                     f'stroke="#222" stroke-width="1.1" '
                     f'marker-end="url(#arr)"/>')
    # internal flows: producer right edge -> elbow -> consumer left edge
    for b in boxes:
        for p in b.ports:
            if p.tag != "o":
                continue
            for q in t.consumers.get(p.name, []):
                if id(q.parent) not in box_ids or q.parent is b:
                    continue
                if q.tag == "c":
                    continue  # controls drawn from top margin
                sx0, sy0 = pos[id(b)]
                dx0, dy0 = pos[id(q.parent)]
                sx = X(sx0 + bw)
                sy = Y(sy0 + 2) + CH // 2
                dxx = X(dx0)
                dyy = Y(dy0 + 2) + CH // 2
                midx = sx + 5 * CW
                o.append(f'<path d="{_elbow(sx, sy, midx, dyy, dxx)}" '
                         f'fill="none" stroke="#222" stroke-width="1.1" '
                         f'marker-end="url(#arr)"/>')
                fl = p if p.doc else q
                o.append(f'<text x="{midx + 4}" y="{(sy + dyy) // 2}" '
                         f'font-size="9"{_dattr(fl)}>{_h.escape(p.name)}'
                         f'{_dtitle(fl)}</text>')
    for b in boxes:
        x0, y0 = pos[id(b)]
        x, y = X(x0), Y(y0)
        w, h = bw * CW, BOX_H * CH
        if rich and b.children:
            o.append(f'<a href="#plate-{b.node_id}">')
        o.append(f'<rect x="{x}" y="{y}" width="{w}" height="{h}" '
                 f'fill="#fff" stroke="#222" stroke-width="1.6"/>')
        nm = b.name if len(b.name) <= bw - 4 else b.name[:bw - 7] + "..."
        o.append(f'<text x="{x + w / 2}" y="{y + 24}" font-size="12" '
                 f'text-anchor="middle"{_dattr(b)}>{_h.escape(nm)}'
                 f'{_dtitle(b)}</text>')
        o.append(f'<text x="{x + w - 6}" y="{y + h - 8}" font-size="10" '
                 f'text-anchor="end" fill="#555">{b.node_id}'
                 f'{"*" if b.children else ""}</text>')
        if rich and b.children:
            o.append('</a>')
        ins = [p for p in b.ports if p.tag == "i"]
        for k, p in enumerate(ins):
            py = y + CH * (1 + min(k, BOX_H - 3)) + CH // 2
            rt = port_route(p, t)
            internal = rt.startswith("from ")
            if internal:
                continue
            lab = p.name + (f"  [{rt}]" if rt else "")
            o.append(f'<path d="M{x - 40},{py} H{x}" fill="none" '
                     f'stroke="#222" stroke-width="1.1" '
                     f'marker-end="url(#arr)"/>')
            o.append(f'<text x="{x - 44}" y="{py - 3}" font-size="9" '
                     f'text-anchor="end"{_dattr(p)}>{_h.escape(lab)}'
                     f'{_dtitle(p)}</text>')
        outs = [p for p in b.ports if p.tag == "o"]
        for k, p in enumerate(outs):
            py = y + CH * (1 + min(k, BOX_H - 3)) + CH // 2
            rt = port_route(p, t)
            if rt.startswith("to "):
                continue
            lab = p.name + (f"  [{rt}]" if rt else "")
            o.append(f'<path d="M{x + w},{py} H{x + w + 40}" fill="none" '
                     f'stroke="#222" stroke-width="1.1" '
                     f'marker-end="url(#arr)"/>')
            o.append(f'<text x="{x + w + 44}" y="{py - 3}" font-size="9"'
                     f'{_dattr(p)}>{_h.escape(lab)}{_dtitle(p)}</text>')
        mechs = [p for p in b.ports if p.tag == "m"]
        if mechs:
            cx = x + w // 2
            o.append(f'<path d="M{cx},{y + h + 30} V{y + h}" fill="none" '
                     f'stroke="#222" stroke-width="1.1" '
                     f'marker-end="url(#arr)"/>')
            parts = []
            for j, p in enumerate(mechs):
                parts.append((", " if j else "")
                             + f'<tspan{_dattr(p)}>{_h.escape(p.name)}'
                             + f'{_dtitle(p)}</tspan>')
            o.append(f'<text x="{cx + 4}" y="{y + h + 28}" font-size="9">'
                     + "".join(parts) + '</text>')
    ty = height - 3 * CH
    nid = plate_id(t, node)
    o.append(f'<rect x="0" y="{ty}" width="{width}" height="{3 * CH}" '
             f'fill="#fff" stroke="#222"/>')
    o.append(f'<line x1="{99}" y1="{ty}" x2="{99}" y2="{height}" '
             f'stroke="#222"/>')
    o.append(f'<line x1="{width - 99}" y1="{ty}" x2="{width - 99}" '
             f'y2="{height}" stroke="#222"/>')
    o.append(f'<text x="10" y="{ty + 16}" font-size="10">NODE</text>')
    o.append(f'<text x="10" y="{ty + 36}" font-size="12">{nid}</text>')
    o.append(f'<text x="110" y="{ty + 16}" font-size="10">TITLE</text>')
    o.append(f'<text x="110" y="{ty + 36}" font-size="12"'
             f'{_dattr(node)}>{_h.escape(node.name)}{_dtitle(node)}</text>')
    o.append(f'<text x="{width - 89}" y="{ty + 16}" font-size="10">NUMBER'
             f'</text>')
    o.append(f'<text x="{width - 89}" y="{ty + 36}" font-size="12">'
             f'p.{pageno}</text>')
    o.append("</svg>")
    return "\n".join(o)


