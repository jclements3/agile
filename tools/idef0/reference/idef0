#!/usr/bin/env python3
"""idef0 -- validator, formatter, and plate renderer for the pipe-path IDEF0 DSL.

Usage:
  idef0 lint  FILE...              validate; GNU-format diagnostics; exit 1 on errors
  idef0 text  FILE...              render plates as character art, form-feed paginated
  idef0 html  FILE...              render HTML drawing set (plates as SVG)
  idef0 svg   NODE FILE...         render one plate (e.g. E22) as standalone SVG
  idef0 dump  FILE...              print numbered model tree(s)
  idef0 links FILE...              print project interface table
  idef0 fmt [--number|--auto] [--write] FILE...
                                   rewrite tag suffixes; --write edits in place
                                   (fmt validates structure only, not links)

Grammar summary (v1):
  line := tag name [< path | > path]     tag := [taicom]( # | digit | LETTER | NUM. )
  path := segment (| segment)*           ; comment lines start with ;
Segment resolution order: child activity by name -> port by flow name
(2+ matches = ambiguous error) -> port ref [icom]N -> node number.
A '<' path ending at an activity with exactly one output takes that output.

Diagnostics use GNU format  file:line: severity: message.
Exit status: 0 clean, 1 errors found, 2 usage failure.
"""

import json
import re
import sys
import difflib
import html as _h

FENCE_OPEN = re.compile(r"^(?P<f>`{3,})\s*idef0\s*$")
FENCE_CLOSE = re.compile(r"^`{3,}\s*$")


TAG_RE = re.compile(
    r"^(?P<indent>[ \t]*)"
    r"(?P<tag>[taicom])"
    r"(?P<suffix>#|[A-Za-z]?\d+\.|[A-Za-z]?\d*)"
    r"(?:\s+(?P<rest>.*))?$"
)

INDENT = 2


class Node:
    def __init__(self, tag, suffix, name, link_dir, link_path, fname, line, indent):
        self.doc = []
        self.trail = None
        self.tag = tag
        self.suffix = suffix
        self.name = name
        self.link_dir = link_dir
        self.link_path = link_path
        self.fname = fname
        self.line = line
        self.indent = indent
        self.parent = None
        self.children = []
        self.ports = []
        self.number = None
        self.letter = None
        self.node_id = None
        self.asserted = None
        self.link_target = None
        self.model = None

    @property
    def is_activity(self):
        return self.tag in ("t", "a")

    def descendants(self):
        for k in self.children:
            yield k
            yield from k.descendants()

    def all_ports(self):
        yield from self.ports
        for k in self.children:
            yield from k.all_ports()


def err(diags, node_or_pair, msg, sev="error"):
    if isinstance(node_or_pair, Node):
        diags.append((node_or_pair.fname, node_or_pair.line, sev, msg))
    else:
        f, ln = node_or_pair
        diags.append((f, ln, sev, msg))


# --------------------------------------------------------------- parsing
def parse_file(fname, text, diags, doc):
    roots = []
    stack = []
    last_node = None
    is_md = fname.lower().endswith((".md", ".markdown"))
    in_fence = not is_md
    fence_len = 0
    fence_line = 0
    records = doc.setdefault(fname, [])
    for lineno, raw in enumerate(text.splitlines(), 1):
        if is_md:
            if not in_fence:
                fm = FENCE_OPEN.match(raw)
                if fm:
                    in_fence = True
                    fence_len = len(fm.group("f"))
                    fence_line = lineno
                records.append(("raw", raw, None))
                continue
            cm = FENCE_CLOSE.match(raw)
            if cm and len(raw.strip()) >= fence_len:
                in_fence = False
                records.append(("raw", raw, None))
                continue
        stripped = raw.strip()
        if stripped.startswith(";;") or stripped.startswith("##"):
            txt = stripped[2:].strip()
            if last_node is None:
                err(diags, (fname, lineno),
                    f"'{stripped[:2]}' doc comment has no element line "
                    "to attach to", "warning")
            else:
                last_node.doc.append(txt if txt else "\\n")
            records.append(("raw", raw, None))
            continue
        if not stripped or stripped[0] in ";#":
            records.append(("raw", raw, None))
            continue
        trail = None
        tm = re.search(r"\s(#.*)$", raw)
        if tm:
            trail = tm.group(1)
            raw_code = raw[:tm.start()]
        else:
            raw_code = raw
        m = TAG_RE.match(raw_code)
        if not m:
            err(diags, (fname, lineno), f"cannot parse line: {stripped!r}")
            records.append(("raw", raw, None))
            continue
        indent = m.group("indent")
        if "\t" in indent:
            err(diags, (fname, lineno), "tabs in indentation; use 2 spaces per level")
            indent = indent.replace("\t", "  ")
        if len(indent) % INDENT:
            err(diags, (fname, lineno),
                f"indentation of {len(indent)} is not a multiple of {INDENT}")
        level = len(indent) // INDENT
        tag = m.group("tag")
        suffix = m.group("suffix") or "#"
        rest = (m.group("rest") or "").strip()

        link_dir = link_path = None
        lm = re.search(r"[<>]", rest)
        name = rest
        if lm:
            link_dir = lm.group(0)
            name = rest[:lm.start()].strip()
            path_txt = rest[lm.end():].strip()
            link_path = [s.strip() for s in path_txt.split("|")]
            if any(not s for s in link_path):
                err(diags, (fname, lineno), "empty segment in link path")
        if "|" in name:
            err(diags, (fname, lineno),
                "'|' not allowed in a name (link paths follow < or >)")
            name = name.replace("|", " ")
        if not name:
            err(diags, (fname, lineno), f"'{tag}' line has no name")

        node = Node(tag, suffix, name, link_dir, link_path, fname, lineno,
                    len(indent))
        node.trail = trail
        if trail and trail.startswith("##"):
            dt = trail[2:].strip()
            node.doc.append(dt if dt else "\\n")
        records.append(("node", raw, node))
        last_node = node

        if tag == "t":
            if level != 0:
                err(diags, node, "model root 't' must be at indentation 0")
            roots.append(node)
            stack = [(0, node)]
            continue
        while stack and stack[-1][0] >= level:
            stack.pop()
        if not stack:
            err(diags, node, f"'{tag}' line has no parent model/activity")
            continue
        plevel, parent = stack[-1]
        if plevel != level - 1:
            err(diags, node, f"indentation jumps from level {plevel} to {level}")
        node.parent = parent
        if tag == "a":
            if not parent.is_activity:
                err(diags, node, "activity nested under a port")
            else:
                parent.children.append(node)
                stack.append((level, node))
        else:
            if not parent.is_activity:
                err(diags, node, "port nested under a port")
            else:
                parent.ports.append(node)
    if is_md and in_fence:
        err(diags, (fname, fence_line),
            "unclosed ```idef0 fence at end of file", "warning")
    return roots


# --------------------------------------------------------------- numbering
def assign_numbers(models, diags):
    letters = {}
    for t in models:
        s = t.suffix
        if s in ("#", ""):
            alpha = [c for c in t.name if c.isalpha()]
            letter = (alpha[0].upper() if alpha else "X")
        elif len(s) == 1 and s.isalpha():
            letter = s.upper()
        else:
            err(diags, t, f"bad model suffix {s!r}: use a single letter or #")
            letter = "X"
        if letter in letters:
            err(diags, t, f"duplicate model letter '{letter}' "
                          f"(also {letters[letter].name!r})")
        letters[letter] = t
        t.letter = letter
        t.node_id = letter
        t.model = t
        _number_children(t, diags)
        _number_ports(t, diags)
        for p in t.ports:
            p.model = t
        for a in t.descendants():
            a.model = t
            _number_ports(a, diags)
            for p in a.ports:
                p.model = t
    return letters


def _number_children(act, diags):
    kids = act.children
    if len(kids) > 9:
        err(diags, act, "more than 9 activities on one plate")
    pinned = {}
    for k in kids:
        s = k.suffix
        k.asserted = None
        if s.endswith("."):
            k.asserted = s[:-1]
            continue
        if s and s != "#" and s.isdigit():
            if len(s) != 1 or s == "0":
                err(diags, k, f"pinned number {s!r} must be a single digit 1-9")
                continue
            d = int(s)
            if d in pinned:
                err(diags, k, f"duplicate pinned digit {d} on plate "
                              f"{act.node_id} (also line {pinned[d].line})")
            else:
                pinned[d] = k
                k.number = d
        elif s not in ("#", "") and not s.endswith("."):
            err(diags, k, f"bad activity suffix {s!r}")
    nxt = 1
    for k in kids:
        if k.number is None:
            while nxt in pinned:
                nxt += 1
            k.number = nxt
            pinned[nxt] = k
            nxt += 1
    base = act.node_id if act.tag == "a" else act.letter
    for k in kids:
        k.node_id = f"{base}{k.number}"
        if k.asserted and k.asserted != k.node_id:
            err(diags, k, f"asserted number {k.asserted} but position derives "
                          f"{k.node_id}")
        _number_children(k, diags)


def _number_ports(act, diags):
    counts = {}
    for p in act.ports:
        s = p.suffix
        n = None
        if s.endswith("."):
            err(diags, p,
                "asserted numbers are for activities; ports take # or a digit")
        elif s.isdigit() and s:
            if len(s) != 1 or s == "0":
                err(diags, p, f"pinned port number {s!r} must be a single digit 1-9")
            else:
                n = int(s)
        elif s not in ("#", ""):
            err(diags, p, f"bad port suffix {s!r}")
        if n is None:
            n = counts.get(p.tag, 0) + 1
        counts[p.tag] = max(counts.get(p.tag, 0), n)
        p.number = n
        p.node_id = f"{act.node_id}.{p.tag}{n}"
        if p.link_dir == "<" and p.tag == "o":
            err(diags, p, "outputs declare goes-to with '>', not '<'")
        if p.link_dir == ">" and p.tag in ("i", "c", "m"):
            err(diags, p, f"'{p.tag}' ports declare comes-from with '<', not '>'")


# --------------------------------------------------------------- wiring
def wire_model(t, diags):
    producers = {}
    consumers = {}
    for p in t.all_ports():
        (producers if p.tag == "o" else consumers).setdefault(p.name, []).append(p)
    t.producers, t.consumers = producers, consumers
    for name, ps in consumers.items():
        if name in producers:
            continue
        cands = difflib.get_close_matches(name, producers.keys(), n=1, cutoff=0.86)
        for p in ps:
            if p.link_dir:
                continue
            if cands:
                err(diags, p, f"'{name}' has no producer; did you mean "
                              f"'{cands[0]}'?", "warning")
    for name, ps in producers.items():
        if name in consumers:
            continue
        cands = difflib.get_close_matches(name, consumers.keys(), n=1, cutoff=0.86)
        for p in ps:
            if p.link_dir:
                continue
            if cands:
                err(diags, p, f"'{name}' has no consumer; did you mean "
                              f"'{cands[0]}'?", "warning")


# --------------------------------------------------------------- links
class Ambig(Exception):
    def __init__(self, act, flow):
        self.act, self.flow = act, flow


def _walk(scope, segs, want):
    """Resolve segs from scope. Returns port or None. Raises Ambig."""
    cur = scope
    for i, seg in enumerate(segs):
        last = (i == len(segs) - 1)
        kids = [k for k in cur.children if k.name == seg]
        if len(kids) == 1:
            cur = kids[0]
            continue
        pmatch = [p for p in cur.ports if p.name == seg]
        if len(pmatch) >= 2:
            raise Ambig(cur, seg)
        if len(pmatch) == 1:
            return pmatch[0] if last else None
        if re.fullmatch(r"[icom][1-9]", seg):
            pr = [p for p in cur.ports
                  if p.tag == seg[0] and p.number == int(seg[1])]
            if pr:
                return pr[0] if last else None
        nn = [k for k in cur.children if k.node_id == seg]
        if len(nn) == 1:
            cur = nn[0]
            continue
        return None
    if want == "<":
        outs = [p for p in cur.ports if p.tag == "o"]
        if len(outs) == 1:
            return outs[0]
    return None


def _suggest(segs, scope_model, letters):
    """Near-match among activity names/node-ids (cutoff 0.75)."""
    names = set(letters.keys())
    for t in letters.values():
        names.add(t.name)
    if scope_model is not None:
        for a in scope_model.descendants():
            names.add(a.name)
            names.add(a.node_id)
    for seg in segs:
        if seg in names:
            continue
        close = difflib.get_close_matches(seg, names, n=1, cutoff=0.75)
        if close:
            return f" (closest: '{close[0]}')"
    return ""


def resolve_links(models, letters, diags):
    by_name = {t.name: t for t in models}
    cross = []
    for t in models:
        for p in t.all_ports():
            if not p.link_dir:
                continue
            segs = p.link_path
            target = None
            addressed = t
            try:
                scope = p.parent
                while scope is not None and target is None:
                    target = _walk(scope, segs, p.link_dir)
                    scope = scope.parent
                if target is None and segs:
                    mt = letters.get(segs[0]) or by_name.get(segs[0])
                    if mt is not None and len(segs) > 1:
                        addressed = mt
                        target = _walk(mt, segs[1:], p.link_dir)
            except Ambig as a:
                err(diags, p, f"'{a.act.name}' has no unique port for flow "
                              f"'{a.flow}'; add the port or use o1/i1 form")
                continue
            if target is None:
                hint = _suggest(segs, addressed, letters)
                err(diags, p,
                    f"broken link: cannot resolve '{'|'.join(segs)}'{hint}")
                continue
            p.link_target = target
            if p.link_dir == "<":
                src, dst = target, p
            else:
                src, dst = p, target
            if src.tag != "o" and not (src.tag == "m" and dst.tag == "m"):
                err(diags, p, f"link source '{src.node_id}' is '{src.tag}' -- "
                              f"flows must originate at an output", "warning")
            if dst.tag == "o":
                err(diags, p, f"link destination '{dst.node_id}' is an output",
                    "warning")
            if src.model is not dst.model:
                cross.append((src, dst, p))
    for src, dst, via in cross:
        other = dst if via is src else src
        if not other.link_dir:
            err(diags, via,
                f"one-sided cross-model link: {other.node_id} "
                f"'{other.name}' does not declare the reciprocal "
                f"{'>' if other.tag == 'o' else '<'} link", "warning")
    rows = []
    seen = set()
    for src, dst, _ in cross:
        for name in ([src.name] if src.name == dst.name
                     else [src.name, dst.name]):
            key = (src.node_id, dst.node_id, name)
            if key in seen:
                continue
            seen.add(key)
            rows.append((src, dst, name))
    rows.sort(key=lambda r: (r[0].model.letter, r[0].node_id,
                             r[1].node_id, r[2]))
    return rows


# --------------------------------------------------------------- project
def load_project(files, diags, links_too=True):
    doc = {}
    models = []
    for f in files:
        try:
            text = open(f, encoding="utf-8").read()
        except OSError as e:
            print(f"idef0: cannot read {f}: {e}", file=sys.stderr)
            sys.exit(2)
        models.extend(parse_file(f, text, diags, doc))
    letters = assign_numbers(models, diags)
    rows = []
    if links_too:
        for t in models:
            wire_model(t, diags)
        rows = resolve_links(models, letters, diags)
    return models, letters, rows, doc


def emit_diags(diags, out=None):
    errs = sum(1 for d in diags if d[2] == "error")
    warns = sum(1 for d in diags if d[2] == "warning")
    for f, ln, sev, msg in sorted(diags, key=lambda d: (d[0], d[1])):
        print(f"{f}:{ln}: {sev}: {msg}", file=out or sys.stdout)
    return errs, warns


def summary(files, diags, models, rows):
    errs = sum(1 for d in diags if d[2] == "error")
    warns = sum(1 for d in diags if d[2] == "warning")
    acts = sum(1 for t in models for _ in t.descendants())
    print(f"{len(files)} file(s): {errs} error(s), {warns} warning(s), "
          f"{len(models)} model(s), {acts} activities, {len(rows)} link(s)")
    return errs


# --------------------------------------------------------------- commands
def cmd_lint(files):
    diags = []
    models, letters, rows, _ = load_project(files, diags)
    emit_diags(diags)
    return 1 if summary(files, diags, models, rows) else 0


def cmd_dump(files):
    diags = []
    models, letters, rows, _ = load_project(files, diags)
    errs, _ = emit_diags(diags)
    for t in models:
        print(f"{t.node_id}  {t.name}    [{t.fname}]")

        def rec(a, depth):
            for p in a.ports:
                lk = ""
                if p.link_dir:
                    lk = f"  {p.link_dir} {'|'.join(p.link_path)}"
                print(f"{'  ' * depth}{p.node_id:<12} {p.tag.upper()} "
                      f"{p.name}{lk}")
            for k in a.children:
                print(f"{'  ' * depth}{k.node_id:<12} {k.name}")
                rec(k, depth + 1)
        rec(t, 1)
        print()
    return 1 if errs else 0


def cmd_links(files):
    diags = []
    models, letters, rows, _ = load_project(files, diags)
    errs, _ = emit_diags(diags)
    print(f"{'SOURCE':<14} {'DEST':<14} FLOW")
    for s, d, name in rows:
        print(f"{s.node_id:<14} {d.node_id:<14} {name}")
    return 1 if errs else 0


# ---------------------------------------------------------- plate layout
BOX_H = 5


def _dkey(t, el):
    """Stable id for a documented element: activity node id, model letter0,
    or parentid.tagN for a port."""
    if el.tag == "t":
        return f"{el.letter}0"
    if el.tag == "a":
        return el.node_id
    par = el.parent
    pid = par.node_id if par.tag == "a" else f"{par.letter}0"
    return f"{pid}.{el.tag}{el.number}"


def _doc_plain(el):
    return " ".join(el.doc).replace("\\n", "\n")


_MD_CODE = re.compile(r"`([^`]+)`")
_MD_BOLD = re.compile(r"\*\*(.+?)\*\*")
_MD_EM = re.compile(r"(?<!\*)\*([^*]+)\*(?!\*)")
_MD_LINK = re.compile(r"\[([^\]]+)\]\(([^)\s]+)\)")


def _md_inline(text):
    s = _h.escape(text)
    s = _MD_CODE.sub(r"<code>\1</code>", s)
    s = _MD_BOLD.sub(r"<strong>\1</strong>", s)
    s = _MD_EM.sub(r"<em>\1</em>", s)
    s = _MD_LINK.sub(r'<a href="\2" target="_blank">\1</a>', s)
    return s


def _doc_html(el):
    paras = [p.strip() for p in " ".join(el.doc).split("\\n")]
    return "".join(f"<p>{_md_inline(p)}</p>" for p in paras if p)


def plates_of(t):
    out = [(t, t.children)]
    for a in t.descendants():
        if a.children:
            out.append((a, a.children))
    return out


def plate_id(t, node):
    return node.node_id if node.tag == "a" else f"{t.letter}0"


def port_route(p, t):
    if p.link_dir:
        o = p.link_target
        if o is None or o.model is None:
            return f"{p.link_dir} {'|'.join(p.link_path)}"
        return f"{p.link_dir} {o.model.letter}:{o.node_id}"
    tbl = t.producers if p.tag != "o" else t.consumers
    peers = [q for q in tbl.get(p.name, []) if q.parent is not p.parent]
    if peers:
        ids = ",".join(sorted({q.parent.node_id for q in peers}))
        return ("from " if p.tag != "o" else "to ") + ids
    return ""


def layout_plate(t, node, boxes):
    """Cell-grid layout per spec: returns (positions, bw, left, top, W, H,
    ext_controls) with positions[id(b)] = (x, y) in character cells."""
    bw = min(26, max(20, max(len(b.name) for b in boxes) + 4))
    in_labels = []
    ext_controls = []
    box_ids = {id(b) for b in boxes}
    for b in boxes:
        for p in b.ports:
            if p.tag == "i":
                r = port_route(p, t)
                in_labels.append(p.name + (f" ({r})" if r else ""))
            if p.tag == "c":
                prod = [q for q in t.producers.get(p.name, [])
                        if id(q.parent) in box_ids]
                if not prod and p.name not in [c for c in ext_controls]:
                    if p.name not in ext_controls:
                        ext_controls.append(p.name)
    left = max(8, (max(len(s) for s in in_labels) + 4) if in_labels else 8)
    top = 2 * len(ext_controls) + 2
    hgap, vgap = 12, 4
    pos = {}
    for i, b in enumerate(boxes):
        pos[id(b)] = (left + i * (bw + hgap), top + i * (BOX_H + vgap))
    lastx, lasty = pos[id(boxes[-1])]
    has_mech = any(p.tag == "m" for b in boxes for p in b.ports)
    W = max(lastx + bw + 28, 64)
    H = lasty + BOX_H + (5 if has_mech else 2) + 6
    return pos, bw, left, top, W, H, ext_controls


def render_text_plate(t, node, boxes, pageno):
    pos, bw, left, top, W, H, ext_controls = layout_plate(t, node, boxes)
    grid = {}

    def put(r, c, s):
        for k, ch in enumerate(s):
            if c + k >= 0:
                grid[(r, c + k)] = ch

    box_ids = {id(b) for b in boxes}
    for ci, cname in enumerate(ext_controls):
        row = 2 * ci
        cons = [b for b in boxes
                if any(p.tag == "c" and p.name == cname for p in b.ports)]
        if not cons:
            continue
        x0, _ = pos[id(cons[0])]
        put(row, x0 + 2, cname)
        for b in cons:
            x, y = pos[id(b)]
            cx = x + bw // 2
            for r in range(row + 1, y):
                if (r, cx) not in grid:
                    put(r, cx, "|")
            put(y - 1, cx, "v")
    for b in boxes:
        x, y = pos[id(b)]
        put(y, x, "+" + "-" * (bw - 2) + "+")
        for r in range(1, BOX_H - 1):
            put(y + r, x, "|" + " " * (bw - 2) + "|")
        put(y + BOX_H - 1, x, "+" + "-" * (bw - 2) + "+")
        nm = b.name if len(b.name) <= bw - 4 else b.name[:bw - 7] + "..."
        put(y + 1, x + 2, nm)
        tagn = b.node_id + ("*" if b.children else "")
        put(y + BOX_H - 2, x + bw - 2 - len(tagn), tagn)
        ins = [p for p in b.ports if p.tag == "i"]
        for k, p in enumerate(ins):
            r = y + 1 + min(k, BOX_H - 3)
            rt = port_route(p, t)
            lab = p.name + (f" ({rt})" if rt else "")
            put(r, x - len(lab) - 4, lab + " ->")
        outs = [p for p in b.ports if p.tag == "o"]
        for k, p in enumerate(outs):
            r = y + 1 + min(k, BOX_H - 3)
            rt = port_route(p, t)
            lab = p.name + (f" ({rt})" if rt else "")
            put(r, x + bw + 1, "-> " + lab)
        mechs = [p for p in b.ports if p.tag == "m"]
        if mechs:
            cx = x + bw // 2
            put(y + BOX_H, cx, "^")
            lab = ", ".join(p.name for p in mechs)
            put(y + BOX_H + 1, x + 2, lab)
    maxr = max((r for r, c in grid), default=0)
    maxc = max((c for r, c in grid), default=0)
    W = max(W, maxc + 2)
    lines = []
    for r in range(0, max(H, maxr + 1)):
        line = "".join(grid.get((r, c), " ") for c in range(W)).rstrip()
        lines.append(line)
    total = max(max((len(l) for l in lines), default=0), 64)
    mid = total - 26
    nid = plate_id(t, node)
    title = node.name
    if len(title) > mid - 2:
        title = title[:mid - 5] + "..."
    num = f"p.{pageno}"
    tb = [
        "+" + "-" * 11 + "+" + "-" * mid + "+" + "-" * 11 + "+",
        "|" + " NODE".ljust(11) + "|" + " TITLE".ljust(mid) + "|"
        + " NUMBER".ljust(11) + "|",
        "|" + f" {nid}".ljust(11) + "|" + f" {title}".ljust(mid) + "|"
        + f" {num}".ljust(11) + "|",
        "+" + "-" * 11 + "+" + "-" * mid + "+" + "-" * 11 + "+",
    ]
    return "\n".join(lines + tb)


def all_plates(models):
    out = []
    for t in models:
        for node, boxes in plates_of(t):
            out.append((t, node, boxes))
    return out


