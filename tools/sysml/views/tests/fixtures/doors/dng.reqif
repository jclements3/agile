<?xml version="1.0" encoding="UTF-8"?>
<REQ-IF xmlns="http://www.omg.org/spec/ReqIF/20110401/reqif.xsd" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <CORE-CONTENT><REQ-IF-CONTENT>
    <DATATYPES/>
    <SPEC-TYPES>
      <SPEC-OBJECT-TYPE IDENTIFIER="T-H" LONG-NAME="Heading"/>
      <SPEC-OBJECT-TYPE IDENTIFIER="T-R" LONG-NAME="Stakeholder Requirement"/>
      <SPEC-OBJECT-TYPE IDENTIFIER="T-I" LONG-NAME="Information"/>
      <SPEC-ATTRIBUTES>
        <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="A-ID" LONG-NAME="Identifier"/>
        <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="A-TI" LONG-NAME="Title"/>
        <ATTRIBUTE-DEFINITION-XHTML IDENTIFIER="A-PT" LONG-NAME="Primary Text"/>
        <ATTRIBUTE-DEFINITION-STRING IDENTIFIER="A-PR" LONG-NAME="Priority"/>
      </SPEC-ATTRIBUTES>
      <SPEC-RELATION-TYPE IDENTIFIER="RT-1" LONG-NAME="Satisfies"/>
    </SPEC-TYPES>
    <SPEC-OBJECTS>
      <SPEC-OBJECT IDENTIFIER="o-1"><TYPE><SPEC-OBJECT-TYPE-REF>T-H</SPEC-OBJECT-TYPE-REF></TYPE><VALUES>
        <ATTRIBUTE-VALUE-STRING THE-VALUE="STK-1"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>A-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
        <ATTRIBUTE-VALUE-STRING THE-VALUE="Mission needs"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>A-TI</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
      </VALUES></SPEC-OBJECT>
      <SPEC-OBJECT IDENTIFIER="o-3"><TYPE><SPEC-OBJECT-TYPE-REF>T-R</SPEC-OBJECT-TYPE-REF></TYPE><VALUES>
        <ATTRIBUTE-VALUE-STRING THE-VALUE="STK-3"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>A-ID</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
        <ATTRIBUTE-VALUE-STRING THE-VALUE="Defend the asset"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>A-TI</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
        <ATTRIBUTE-VALUE-XHTML><DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>A-PT</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION><THE-VALUE><xhtml:div><xhtml:p>The system shall defend the designated asset against the <xhtml:b>threat set</xhtml:b>.</xhtml:p></xhtml:div></THE-VALUE></ATTRIBUTE-VALUE-XHTML>
        <ATTRIBUTE-VALUE-STRING THE-VALUE="High"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>A-PR</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
      </VALUES></SPEC-OBJECT>
      <SPEC-OBJECT IDENTIFIER="o-4"><TYPE><SPEC-OBJECT-TYPE-REF>T-I</SPEC-OBJECT-TYPE-REF></TYPE><VALUES>
        <ATTRIBUTE-VALUE-XHTML><DEFINITION><ATTRIBUTE-DEFINITION-XHTML-REF>A-PT</ATTRIBUTE-DEFINITION-XHTML-REF></DEFINITION><THE-VALUE><xhtml:div>Threat set is defined in the STAR.</xhtml:div></THE-VALUE></ATTRIBUTE-VALUE-XHTML>
      </VALUES></SPEC-OBJECT>
    </SPEC-OBJECTS>
    <SPEC-RELATIONS/>
    <SPECIFICATIONS>
      <SPECIFICATION IDENTIFIER="s-1" LONG-NAME="Stakeholder Needs"><CHILDREN>
        <SPEC-HIERARCHY IDENTIFIER="h-1"><OBJECT><SPEC-OBJECT-REF>o-1</SPEC-OBJECT-REF></OBJECT><CHILDREN>
          <SPEC-HIERARCHY IDENTIFIER="h-3"><OBJECT><SPEC-OBJECT-REF>o-3</SPEC-OBJECT-REF></OBJECT></SPEC-HIERARCHY>
          <SPEC-HIERARCHY IDENTIFIER="h-4"><OBJECT><SPEC-OBJECT-REF>o-4</SPEC-OBJECT-REF></OBJECT></SPEC-HIERARCHY>
        </CHILDREN></SPEC-HIERARCHY>
      </CHILDREN></SPECIFICATION>
    </SPECIFICATIONS>
  </REQ-IF-CONTENT></CORE-CONTENT>
