def cmd_html(files):
    diags = []
    models, letters, rows, _ = load_project(files, diags)
    errs, _ = emit_diags(diags, out=sys.stderr)
    if errs:
        return 1
    plates = all_plates(models)
    pageof = {plate_id(t, node): i + 2
              for i, (t, node, boxes) in enumerate(plates)}
    docs = {}
    for t in models:
        for el in [t] + list(t.descendants()):
            if el.doc:
                docs[_dkey(t, el)] = _doc_html(el)
            for p in el.ports:
                if p.doc:
                    docs[_dkey(t, p)] = _doc_html(p)
    out = ["<!doctype html><meta charset='utf-8'>"
           "<meta name='viewport' content='width=device-width,"
           "initial-scale=1'><title>IDEF0 drawing set</title>"
           f"<style>{HTML_CSS}</style>"]
    out.append("<h1 id='top'>IDEF0 drawing set &mdash; p.1: node index and "
               "interface table</h1>")
    out.append("<table><tr><th>NODE</th><th>TITLE</th><th>NUMBER</th></tr>")
    for i, (t, node, boxes) in enumerate(plates):
        pid = plate_id(t, node)
        k = _dkey(t, node)
        cls = f" class='hasdoc' data-doc='{k}'" if k in docs else ""
        out.append(f"<tr><td><a href='#plate-{pid}'>{pid}</a></td>"
                   f"<td{cls}>{_h.escape(node.name)}</td>"
                   f"<td><a href='#plate-{pid}'>p.{i + 2}</a></td></tr>")
    out.append("</table>")
    out.append("<table><tr><th>SOURCE</th><th>DEST</th><th>FLOW</th></tr>")
    for s, d, name in rows:
        sp = _plate_of_port(s, pageof)
        dp = _plate_of_port(d, pageof)
        sc = (f"<a href='#plate-{sp}'>{s.node_id}</a>" if sp else s.node_id)
        dc = (f"<a href='#plate-{dp}'>{d.node_id}</a>" if dp else d.node_id)
        out.append(f"<tr><td>{sc}</td><td>{dc}</td>"
                   f"<td>{_h.escape(name)}</td></tr>")
    out.append("</table>")
    for i, (t, node, boxes) in enumerate(plates):
        pid = plate_id(t, node)
        out.append(f"<div class='plate' id='plate-{pid}'>")
        nav = ["<a href='#top'>&#8962; index</a>"]
        if node.tag == "a":
            par = node.parent
            up = par.node_id if par.tag == "a" else f"{par.letter}0"
            nav.append(f"<a href='#plate-{up}'>&#8593; {up}</a>")
        else:
            nav.append("<span class='dim'>top plate</span>")
        nav.append("<a href='javascript:history.back()'>&#8592; back</a>")
        nav.append("<a href='javascript:history.forward()'>fwd &#8594;</a>")
        nav.append("<a href='#' class='vz' title='reset pan/zoom "
                   "(ctrl+scroll or pinch to zoom, middle-drag to pan)'>"
                   "&#10530; reset</a>")
        nav.append(f"<span class='dim'>{pid} &middot; p.{i + 2}</span>")
        out.append("<div class='nav'>" + " &middot; ".join(nav) + "</div>")
        if node.doc:
            out.append("<details class='notes'><summary>notes: "
                       f"{_h.escape(node.name)}</summary>"
                       + _doc_html(node) + "</details>")
        out.append("<div class='vp'>")
        out.append(svg_plate(t, node, boxes, i + 2, rich=True, pageof=pageof))
        out.append("</div>")
        out.append("</div>")
    payload = json.dumps(docs).replace("</", "<\\/")
    out.append(f"<div id='tip'></div><script>const DOCS={payload};\n"
               + HTML_JS + PANZOOM_JS + "</script>")
    print("\n".join(out))
    return 0


# --------------------------------------------------------------- fmt
def cmd_fmt(mode, write, files):
    diags = []
    models, letters, rows, doc = load_project(files, diags, links_too=False)
    errs, _ = emit_diags(diags, out=sys.stderr)
    if errs:
        print("fmt: refusing to rewrite files with errors", file=sys.stderr)
        return 1
    for f in files:
        lines = []
        for kind, raw, node in doc[f]:
            if kind == "raw" or node is None:
                lines.append(raw)
                continue
            if mode == "number":
                if node.tag == "t":
                    sfx = node.letter
                else:
                    sfx = str(node.number)
            elif mode == "auto":
                sfx = "#"
            else:
                sfx = node.suffix if node.suffix else "#"
            q = node.variant or ("*" if node.many else "")
            line = (" " * node.indent + node.tag + q + sfx + " " + node.name)
            if node.ftype:
                line += " : " + node.ftype
            if node.link_dir:
                line += f" {node.link_dir} " + "|".join(node.link_path)
            if node.trail:
                line += "  " + node.trail
            lines.append(line)
        text = "\n".join(lines) + "\n"
        if write:
            open(f, "w", encoding="utf-8").write(text)
        else:
            if len(files) > 1:
                print(f"==> {f} <==")
            sys.stdout.write(text)
    if write:
        print(f"fmt: rewrote {len(files)} file(s) [{mode or 'normalize'}]")
    return 0


# --------------------------------------------------------------- ledger
LEDGER_FENCE = re.compile(r"^(`{3,})\s*ledger\s*$")
PERIOD_RE = re.compile(r"^\d{4}-W\d{2}$")
ACCT_RE = re.compile(r"^([A-Z][0-9]*)(?::([A-Za-z][\w-]*))?$")


def _ledger_scan(files, ids, diags):
    """Parse ```ledger fences: budget blocks and journal entries."""
    entries, budgets, periods = [], [], set()

    def acct_ok(acc, f, ln):
        m2 = ACCT_RE.match(acc)
        if not m2 or m2.group(1) not in ids:
            err(diags, (f, ln), f"posting to unknown account '{acc}'"
                f" (node id not in model set)")
            return False
        return True

    for f in files:
        if not f.lower().endswith((".md", ".markdown")):
            continue
        in_f, flen = False, 0
        block = None  # (kind, period, [(acct, amt, ln)], ln)
        for ln, raw in enumerate(open(f, encoding="utf-8").read()
                                 .splitlines(), 1):
            if not in_f:
                fm = LEDGER_FENCE.match(raw)
                if fm:
                    in_f, flen = True, len(fm.group(1))
                continue
            if FENCE_CLOSE.match(raw) and len(raw.strip()) >= flen:
                in_f = False
                if block:
                    _ledger_close(block, f, entries, budgets, diags)
                    block = None
                continue
            s = raw.strip()
            if not s or s.startswith("#"):
                continue
            if not raw.startswith(" "):
                if block:
                    _ledger_close(block, f, entries, budgets, diags)
                parts = s.split(None, 1)
                if parts[0] == "budget":
                    per = parts[1].strip() if len(parts) > 1 else ""
                    kind = "budget"
                else:
                    per, kind = parts[0], "entry"
                if not PERIOD_RE.match(per):
                    err(diags, (f, ln), f"bad period '{per}': use YYYY-Www")
                    block = None
                    continue
                if int(per[-2:]) % 2 == 0:
                    err(diags, (f, ln), f"period '{per}' must name the odd "
                        f"ISO week of the pair")
                periods.add(per)
                block = (kind, per, [], ln)
            else:
                if block is None:
                    err(diags, (f, ln), "posting outside an entry")
                    continue
                ps = s.rsplit(None, 1)
                if len(ps) != 2:
                    err(diags, (f, ln), f"bad posting: {s!r}")
                    continue
                acc, amt = ps
                try:
                    v = float(amt)
                except ValueError:
                    err(diags, (f, ln), f"bad amount {amt!r}")
                    continue
                if acct_ok(acc, f, ln):
                    block[2].append((acc, v, ln))
        # unclosed fence at EOF already warned by idef0 fence logic? no:
        if in_f and block:
            _ledger_close(block, f, entries, budgets, diags)
    return entries, budgets, periods


def _ledger_close(block, f, entries, budgets, diags):
    kind, per, posts, ln = block
    if abs(sum(v for _, v, _ in posts)) > 0.005:
        err(diags, (f, ln), f"unbalanced {kind} "
            f"(sums to {sum(v for _, v, _ in posts):g})")
    (budgets if kind == "budget" else entries).append((per, posts))


def cmd_ledger(files, forecast=False):
    diags = []
    models, letters, rows, _ = load_project(files, diags)
    ids = {t.letter: t for t in models}
    for t in models:
        for a in t.descendants():
            ids[a.node_id] = a
    entries, budgets, periods = _ledger_scan(files, ids, diags)
    errs, _ = emit_diags(diags)
    def roll(posts_list):
        m = {}
        for per, posts in posts_list:
            for acc, v, _ in posts:
                nid = ACCT_RE.match(acc).group(1)
                m[nid] = m.get(nid, 0.0) + v
        return m
    bud, act = roll(budgets), roll(entries)
    bper = {p for p, _ in budgets}
    aper = {p for p, _ in entries}
    scale = (len(bper) / len(aper)) if (forecast and aper) else None

    def subtotal(m, node):
        tot = m.get(node.node_id, 0.0)
        for k in node.children:
            tot += subtotal(m, k)
        return tot

    print(f"{'NODE':<10} {'ACTIVITY':<30} {'BUDGET':>10} "
          f"{'ACTUAL':>10} {'VAR':>10}"
          + (f" {'FCAST':>10}" if forecast else ""))

    def rec(node, depth):
        b, a = subtotal(bud, node), subtotal(act, node)
        if abs(b) < 0.005 and abs(a) < 0.005:
            return
        line = (f"{node.node_id:<10} {'  ' * depth + node.name:<30.30} "
                f"{b:>10.2f} {a:>10.2f} {b - a:>10.2f}")
        if forecast:
            line += f" {a * (scale or 1):>10.2f}"
        print(line)
        for k in node.children:
            rec(k, depth + 1)
    for t in models:
        rec(t, 0)
    print(f"{len(entries)} entr(y/ies), {len(budgets)} budget block(s), "
          f"{len(periods)} period(s)")
    return 1 if errs else 0


# --------------------------------------------------------------- main
def main(argv):
    if len(argv) < 2:
        print(__doc__)
        return 2
    cmd, args = argv[1], argv[2:]
    if cmd == "ledger":
        fc = "--forecast" in args
        return cmd_ledger([a for a in args if a != "--forecast"], fc)
    if cmd == "lint":
        return cmd_lint(args)
    if cmd == "dump":
        return cmd_dump(args)
    if cmd == "links":
        return cmd_links(args)
    if cmd == "text":
        return cmd_text(args)
    if cmd == "html":
        return cmd_html(args)
    if cmd == "svg":
        if not args:
            print("usage: idef0 svg NODE FILE...", file=sys.stderr)
            return 2
        return cmd_svg(args[0], args[1:])
    if cmd == "fmt":
        mode = None
        write = False
        files = []
        for a in args:
            if a == "--number":
                mode = "number"
            elif a == "--auto":
                mode = "auto"
            elif a == "--write":
                write = True
            else:
                files.append(a)
        return cmd_fmt(mode, write, files)
    print(f"idef0: unknown command {cmd!r}", file=sys.stderr)
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
