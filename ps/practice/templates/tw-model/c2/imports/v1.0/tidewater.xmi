  <sysml:Block xmi:id="_22_1_7f3a0c1_a702b7cabb22" base_Class="_22_1_7f3a0c1_31e1bd5cc281"/>
  <sysml:Block xmi:id="_22_1_7f3a0c1_a4a9c20de663" base_Class="_22_1_7f3a0c1_d4b78d5168e5"/>
  <sysml:Requirement xmi:id="_22_1_7f3a0c1_d9caf58c17a7" base_Class="_22_1_7f3a0c1_5e7e1ad33fc2" Id="TW-STK-001" Text="The network shall provide marine weather observations for the coastal region it covers."/>
  <sysml:Requirement xmi:id="_22_1_7f3a0c1_11a959e00a6f" base_Class="_22_1_7f3a0c1_b83a265d62a9" Id="TW-STK-002" Text="Forecasters shall receive observations in time to use them in the next bulletin."/>
  <sysml:Requirement xmi:id="_22_1_7f3a0c1_6540bd469cb6" base_Class="_22_1_7f3a0c1_d7fba08ce1ec" Id="TW-STK-003" Text="Mariners shall be able to read the latest bulletin and observations from a public service."/>
  <sysml:Requirement xmi:id="_22_1_7f3a0c1_3fa9f6e98c1c" base_Class="_22_1_7f3a0c1_b129751ce5d4" Id="TW-STK-004" Text="Field crews shall be able to service any station from a single service vessel."/>
  <sysml:Requirement xmi:id="_22_1_7f3a0c1_e1a8bbb045c1" base_Class="_22_1_7f3a0c1_63f0db2b50c2" Id="TW-STK-005" Text="Past observations shall be kept so earlier conditions can be reviewed."/>
  <sysml:Requirement xmi:id="_22_1_7f3a0c1_72614f5d678c" base_Class="_22_1_7f3a0c1_cb8d53c384d7" Id="TW-STK-006" Text="Offshore stations shall keep observing without shore power."/>
  <MD_Customization_for_Requirements__additional_stereotypes:functionalRequirement xmi:id="_22_1_7f3a0c1_8c4d89df593e" base_Class="_22_1_7f3a0c1_dd757905a7cc" Id="TW-SYS-001" Text="Each station shall measure wind, air pressure and air temperature, and each buoy shall also measure waves." risk="Low" verifyMethod="Test"/>
  <MD_Customization_for_Requirements__additional_stereotypes:functionalRequirement xmi:id="_22_1_7f3a0c1_8d025d8c7475" base_Class="_22_1_7f3a0c1_b36bb4f6cff9" Id="TW-SYS-002" Text="Each station shall transmit its observations to the data center on a fixed schedule." risk="Low" verifyMethod="Test"/>
  <MD_Customization_for_Requirements__additional_stereotypes:functionalRequirement xmi:id="_22_1_7f3a0c1_de07ce23d260" base_Class="_22_1_7f3a0c1_669f971ffa64" Id="TW-SYS-003" Text="The data center shall ingest every observation it receives." risk="Low" verifyMethod="Test"/>
  <MD_Customization_for_Requirements__additional_stereotypes:functionalRequirement xmi:id="_22_1_7f3a0c1_ae20470a4a23" base_Class="_22_1_7f3a0c1_d72c631fe423" Id="TW-SYS-004" Text="The data center shall flag observations that fail a quality check." risk="Low" verifyMethod="Test"/>
  <MD_Customization_for_Requirements__additional_stereotypes:functionalRequirement xmi:id="_22_1_7f3a0c1_7eaa8750e4c0" base_Class="_22_1_7f3a0c1_70913ac715f2" Id="TW-SYS-005" Text="The data center shall archive every observation together with its quality flag." risk="Low" verifyMethod="Demonstration"/>
  <MD_Customization_for_Requirements__additional_stereotypes:functionalRequirement xmi:id="_22_1_7f3a0c1_b6bc20c6674e" base_Class="_22_1_7f3a0c1_343cca00ef32" Id="TW-SYS-006" Text="The data center shall publish a marine bulletin on a fixed schedule." risk="Low" verifyMethod="Demonstration"/>
  <MD_Customization_for_Requirements__additional_stereotypes:functionalRequirement xmi:id="_22_1_7f3a0c1_291aaf6a04fe" base_Class="_22_1_7f3a0c1_ebda5f95d8df" Id="TW-SYS-007" Text="The public service shall show the latest observation from every station." risk="Low" verifyMethod="Demonstration"/>
  <MD_Customization_for_Requirements__additional_stereotypes:interfaceRequirement xmi:id="_22_1_7f3a0c1_abcf60edc2e6" base_Class="_22_1_7f3a0c1_695ea251e1c2" Id="TW-SYS-008" Text="Stations shall send observations to the data center over the observation interface." risk="Low" verifyMethod="Test"/>
  <MD_Customization_for_Requirements__additional_stereotypes:interfaceRequirement xmi:id="_22_1_7f3a0c1_95f6e2df1c19" base_Class="_22_1_7f3a0c1_62a45c1ecac4" Id="TW-SYS-009" Text="Stations shall report their health to the data center over the health interface." risk="Low" verifyMethod="Test"/>
  <MD_Customization_for_Requirements__additional_stereotypes:interfaceRequirement xmi:id="_22_1_7f3a0c1_2eb45c17291d" base_Class="_22_1_7f3a0c1_af06d7105f08" Id="TW-SYS-010" Text="The data center shall offer observations through a documented public interface." risk="Low" verifyMethod="Inspection"/>
  <MD_Customization_for_Requirements__additional_stereotypes:performanceRequirement xmi:id="_22_1_7f3a0c1_4da5f987dceb" base_Class="_22_1_7f3a0c1_f832863d9d67" Id="TW-SYS-011" Text="Each buoy shall run from its own solar panel and battery." risk="Low" verifyMethod="Analysis"/>
  <MD_Customization_for_Requirements__additional_stereotypes:designConstraint xmi:id="_22_1_7f3a0c1_5c2c45cb6f61" base_Class="_22_1_7f3a0c1_20810da973a3" Id="TW-SYS-012" Text="Every station shall be serviceable from the service vessel." risk="Low" verifyMethod="Inspection"/>
  <MD_Customization_for_Requirements__additional_stereotypes:functionalRequirement xmi:id="_22_1_7f3a0c1_41169ad4d630" base_Class="_22_1_7f3a0c1_5a6cc70d7869" Id="TW-SYS-013" Text="Each station shall keep observations it could not send and send them once the link returns." risk="Low" verifyMethod="Test"/>
  <MD_Customization_for_Requirements__additional_stereotypes:functionalRequirement xmi:id="_22_1_7f3a0c1_67035fbf79e4" base_Class="_22_1_7f3a0c1_f39bdaeef850" Id="TW-SYS-014" Text="Each station shall report its operating mode." risk="Low" verifyMethod="Test"/>
  <MD_Customization_for_Requirements__additional_stereotypes:functionalRequirement xmi:id="_22_1_7f3a0c1_bc30b21adbae" base_Class="_22_1_7f3a0c1_4c5a7e73285e" Id="TW-SYS-015" Text="The data center shall keep a log of every bulletin it published." risk="Low" verifyMethod="Inspection"/>
  <MD_Customization_for_Requirements__additional_stereotypes:physicalRequirement xmi:id="_22_1_7f3a0c1_63e9c7622537" base_Class="_22_1_7f3a0c1_fc7ae94be23f" Id="TW-SEG-001" Text="The buoy hull shall carry the sensor suite above the waterline." risk="Low" verifyMethod="Inspection"/>
  <MD_Customization_for_Requirements__additional_stereotypes:performanceRequirement xmi:id="_22_1_7f3a0c1_db670051bbbc" base_Class="_22_1_7f3a0c1_02d720e73204" Id="TW-SEG-002" Text="The mooring shall keep the buoy within its assigned watch circle." risk="Low" verifyMethod="Analysis"/>
  <MD_Customization_for_Requirements__additional_stereotypes:functionalRequirement xmi:id="_22_1_7f3a0c1_bb64a4692776" base_Class="_22_1_7f3a0c1_9d23343f3c65" Id="TW-SEG-003" Text="The power system shall report the battery state of charge." risk="Low" verifyMethod="Test"/>
  <MD_Customization_for_Requirements__additional_stereotypes:functionalRequirement xmi:id="_22_1_7f3a0c1_46b2951c2ca6" base_Class="_22_1_7f3a0c1_2eb890addee5" Id="TW-SEG-004" Text="The telemetry unit shall retry a failed transmission." risk="Low" verifyMethod="Test"/>
  <MD_Customization_for_Requirements__additional_stereotypes:designConstraint xmi:id="_22_1_7f3a0c1_c45afa860ec3" base_Class="_22_1_7f3a0c1_608970f914f8" Id="TW-SEG-009" Text="The shore station mast shall be lowerable for maintenance." risk="Low" verifyMethod="Inspection"/>
  <MD_Customization_for_Requirements__additional_stereotypes:functionalRequirement xmi:id="_22_1_7f3a0c1_74653dbc23ef" base_Class="_22_1_7f3a0c1_09891cd25a09" Id="TW-SEG-005" Text="The ingest service shall discard duplicate observations." risk="Low" verifyMethod="Test"/>
  <MD_Customization_for_Requirements__additional_stereotypes:functionalRequirement xmi:id="_22_1_7f3a0c1_7d1f2029fabc" base_Class="_22_1_7f3a0c1_2111488cc3bd" Id="TW-SEG-006" Text="The quality control service shall record why an observation was flagged." risk="Low" verifyMethod="Test"/>
  <MD_Customization_for_Requirements__additional_stereotypes:functionalRequirement xmi:id="_22_1_7f3a0c1_1851e30043d0" base_Class="_22_1_7f3a0c1_ffe7bcd02b38" Id="TW-SEG-007" Text="The archive shall return any observation by station and time." risk="Low" verifyMethod="Demonstration"/>
  <MD_Customization_for_Requirements__additional_stereotypes:functionalRequirement xmi:id="_22_1_7f3a0c1_e4f7e95e4421" base_Class="_22_1_7f3a0c1_60a945737921" Id="TW-SEG-008" Text="The publisher shall stamp each bulletin with its issue time." risk="Low" verifyMethod="Inspection"/>
