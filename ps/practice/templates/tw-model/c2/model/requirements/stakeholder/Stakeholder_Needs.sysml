    requirement TW_STK_005 { doc /* Past observations shall be kept so earlier conditions can be reviewed. */ attribute doorsId = "TW-STK-005"; attribute title = "Observation history"; }
    requirement TW_STK_006 { doc /* Offshore stations shall keep observing without shore power. */ attribute doorsId = "TW-STK-006"; attribute title = "Off-grid operation"; }
