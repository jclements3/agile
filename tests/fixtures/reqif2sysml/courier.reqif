              <THE-VALUE><xhtml:div>Safety &amp; Environment</xhtml:div></THE-VALUE></ATTRIBUTE-VALUE-XHTML>
          </VALUES>
        </SPEC-OBJECT>
        <SPEC-OBJECT IDENTIFIER="o-h21" LAST-CHANGE="2026-09-30T10:00:00Z">
