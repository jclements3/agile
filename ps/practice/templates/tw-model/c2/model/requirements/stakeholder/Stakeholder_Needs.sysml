    requirement TW_STK_001 { doc /* The network shall provide marine weather observations for the coastal region it covers. */ attribute doorsId = "TW-STK-001"; attribute title = "Coastal coverage"; }
    requirement TW_STK_002 { doc /* Forecasters shall receive observations in time to use them in the next bulletin. */ attribute doorsId = "TW-STK-002"; attribute title = "Timely observations"; }
